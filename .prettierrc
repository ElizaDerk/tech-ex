{
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "singleAttributePerLine": true,
  "vueIndentScriptAndStyle": false,
  "proseWrap": "preserve",
  "printWidth": 120,
  "requirePragma": false,
  "useTabs": true,
  "embeddedLanguageFormatting": "auto",
  "tabWidth": 2,
  "rangeStart": 0,
  "endOfLine": "auto"
}
